{
    "name": "stream-deck-voicemeeter",
    "version": "0.1.0",
    "private": true,
    "description": "Stream Deck plugin for Voicemeeter macro buttons that leaves titles and icons to Stream Deck.",
    "author": "Thomas Albans",
    "license": "MIT",
    "scripts": {
        "build": "rollup -c",
        "watch": "rollup -c -w --watch.onEnd=\"streamdeck restart com.thomasalbans.voicemeeter-macros\"",
        "typecheck": "tsc --noEmit",
        "validate": "streamdeck validate com.thomasalbans.voicemeeter-macros.sdPlugin",
        "pack": "npm run build && streamdeck pack com.thomasalbans.voicemeeter-macros.sdPlugin --output dist --force",
        "dev:enable": "streamdeck dev",
        "dev:disable": "streamdeck dev --disable"
    },
    "type": "module",
    "dependencies": {
        "@elgato/streamdeck": "^3.0.2",
        "koffi": "^3.3.3"
    },
    "devDependencies": {
        "@elgato/cli": "^1.10.2",
        "@rollup/plugin-commonjs": "^29.0.3",
        "@rollup/plugin-node-resolve": "^15.3.1",
        "@rollup/plugin-terser": "^1.0.0",
        "@rollup/plugin-typescript": "^12.3.0",
        "@tsconfig/node20": "^20.1.10",
        "@types/node": "~24.1.0",
        "rollup": "^4.64.8",
        "tslib": "^2.8.1",
        "typescript": "^5.9.3"
    }
}
